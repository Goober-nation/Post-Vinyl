# slskd configuration reference for Musica.
#
# slskd's *actual* runtime config lives in ./slskd_config/ (bind-mounted to
# /app inside the container — see docker-compose.yml), which is entirely
# gitignored because it holds live state alongside config. This file is the
# tracked reference companion, mirroring the config.toml / config.toml.example
# pattern used for the musica app itself.
#
# slskd is currently configured almost entirely via environment variables in
# docker-compose.yml (the SLSKD_* vars on the `slskd` service), not via this
# YAML file directly — slskd merges env vars, this file (if present at
# /app/slskd.yml), and its web-based Options editor, with env vars taking
# precedence. This file documents the equivalent YAML shape for everything
# currently set, plus the full set of options slskd supports, for future
# tuning without re-deriving it from slskd's docs each time.
#
# To use this file directly instead of (or alongside) the env vars: copy it
# to ./slskd_config/slskd.yml on the host.

# ============================================================================
# ACTIVE — mirrors what docker-compose.yml's `slskd` service sets today
# ============================================================================

# soulseek.username/password are deliberately NOT set here — same
# ${VAR}-doesn't-substitute-in-this-file issue as directories.downloads
# below (confirmed live 2026-08-14). They're driven entirely by the real
# SLSKD_SLSK_USERNAME/SLSKD_SLSK_PASSWORD env vars docker-compose.yml passes
# in (from SLSKD_NETWORK_USERNAME/PASSWORD in .env). Setting a literal
# "${SLSKD_NETWORK_USERNAME}"-style placeholder here would shadow those and
# make slskd try to log into Soulseek with that literal string.
soulseek:
  # username: <set via SLSKD_SLSK_USERNAME env var — do not set here>
  # password: <set via SLSKD_SLSK_PASSWORD env var — do not set here>
  listen_port: 50300                    # SLSKD_SLSK_LISTEN_PORT

shares:
  directories:
    - /music/library                    # SLSKD_SHARED_DIR

remote_configuration: true              # SLSKD_REMOTE_CONFIGURATION — lets the
                                         # web UI's Options editor write back
                                         # to this file

# directories.downloads is deliberately NOT set here — confirmed live
# 2026-08-14 that slskd does NOT do ${VAR} substitution inside this YAML
# file (unlike docker-compose.yml's own ${VAR} syntax): a literal
# "${SLSKD_DOWNLOADS_DIR}" string here got used as-is and slskd failed to
# boot ("non-existent directory '/slskd/${SLSKD_DOWNLOADS_DIR}'"). Any value
# here — even a broken placeholder — shadows the real SLSKD_DOWNLOADS_DIR
# env var docker-compose.yml passes in, so the key must stay absent/commented
# for the env var to actually take effect.
# directories:
#   downloads: <set via SLSKD_DOWNLOADS_DIR env var — see docker-compose.yml>
#   # Must live under /music (the volume shared with postvinyl) — slskd's
#   # own default (<data_dir>/downloads, i.e. /app/downloads) is on the
#   # ./slskd_config bind mount instead, which postvinyl can't see at all.
#   # Without this, download_monitor.py's _resolve_source_path() never finds
#   # a completed transfer and it silently times out after
#   # missing_source_timeout_minutes (default 5min), dropping the download
#   # entirely — found live 2026-08-14 via a naked-clone test: every
#   # successful Soulseek transfer was lost because this key was never
#   # packaged for a fresh clone.

# web.authentication.api_keys.musica.key is also NOT set here for the same
# reason — driven by the real SLSKD_API_KEY env var (generated by setup.sh).
# username/password (SLSKD_USERNAME/SLSKD_PASSWORD) are commented out in
# docker-compose.yml today — the web UI is unauthenticated on the
# container-internal network.
# web:
#   authentication:
#     api_keys:
#       musica:
#         key: <set via SLSKD_API_KEY env var — do not set here>

transfers:
  downloads:
    existing_file_behavior: Overwrite   # SLSKD_TRANSFERS_DOWNLOADS_EXISTING_FILE_BEHAVIOR
  download:
    # slskd's own default destination.subdirectory is ${SOURCE_DIRECTORY}
    # (the remote peer's share folder name) — collision-prone across peers
    # and not what download_monitor.py expects. It looks for
    # {downloads}/{SOURCE_USERNAME}/..., so the username must be the
    # top-level subdirectory. ${USERNAME} does NOT work (slskd leaves it as
    # a literal unsubstituted string) — the correct token is SOURCE_USERNAME.
    # No env var equivalent for this one — must stay in this file.
    destination:
      subdirectory: ${SOURCE_USERNAME}/${SOURCE_DIRECTORY}
      exists: rename

# Connection timeouts — NOT YET TUNED. Backlog item (Phase 6.4d) proposes
# lowering connect/inactivity to ~8000ms to fail fast on unresponsive peers
# and speed up DownloadMonitor's retry cycling, but that needs an empirical
# benchmark against live slskd before changing the defaults below — see
# BACKLOG.md. Do NOT lower `transfer`: real Soulseek clients throttle in
# bursts (full speed ~5s, silent gaps up to ~25s per slskd's own docs), so a
# short transfer timeout would kill legitimate slow-but-working transfers.
# soulseek:
#   connection:
#     timeout:
#       connect: 10000      # ms — slskd default; candidate to lower to ~8000
#       inactivity: 15000   # ms — slskd default; candidate to lower to ~8000
#       transfer: 30000     # ms — slskd default; leave alone (see note above)

# ============================================================================
# REFERENCE — full set of options slskd supports (commented out).
# Values shown are slskd's own defaults unless noted. Anything above in the
# ACTIVE section overrides the matching default here.
# ============================================================================

# remote_configuration: false   # allow the web Options editor to persist changes here
# instance_name: default
# no_logo: false
# debug: false

# app_dir: ~/.local/share/slskd            # override with SLSKD_APP_DIR
# data_dir: <app_dir>/data
# logs_dir: <app_dir>/logs

# permissions:
#   file:
#     mode: 644
#   directory:
#     mode: 755

# flags:
#   no_start: false
#   no_connect: false
#   no_share_scan: false
#   force_share_scan: false
#   no_version_check: false

# feature:
#   swagger: false

# soulseek:
#   address: vps.slsknet.org
#   port: 2416
#   username: <required>
#   password: <required>
#   description: A slskd user has not set a description.
#   listen_port: 50300
#   distributed_network:
#     disable_children: false
#     child_limit: 25
#     accept_child_limit: 25
#     accept_parent: true
#   connection:
#     timeout:
#       connect: 10000      # ms
#       inactivity: 15000   # ms
#       transfer: 30000     # ms — see ACTIVE section note; do not lower blind
#     buffer:
#       read: 16384         # bytes
#       write: 16384        # bytes
#     proxy:
#       enabled: false
#       address: ~
#       port: ~
#       username: ~
#       password: ~
#   diagnostic_level: Info   # None, Warning, Info, Debug

# shares:
#   directories: []          # list of absolute paths to share
#   filters: []               # regex patterns to exclude from shares
#   cache:
#     storage_mode: Memory    # Memory, Disk
#     workers: <cpu count>
#     retention_days: -1      # -1 = never expire

