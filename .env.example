# Post-Vinyl Docker stack — combined secrets for app + Navidrome + slskd + proxy
# Copy this file to .env and fill in real values. Never commit .env.
# Auto-loaded by `docker compose` from this directory — no flag needed.

# --- Host paths ---
MUSIC_HOST_DIR=/path/to/host/music

# --- postvinyl app secrets (read by app/config.py) ---
NAVIDROME_USERNAME=
NAVIDROME_PASSWORD=
SLSKD_API_KEY=
LISTENBRAINZ_TOKEN=
LISTENBRAINZ_USERNAME=

# HTTP Basic Auth gate for the whole app (single user). Leave both blank to
# disable — acceptable only for a single-machine trusted-network deployment.
MUSICA_AUTH_USERNAME=
MUSICA_AUTH_PASSWORD=

# --- slskd container ---
# SLSKD_NETWORK_* = your real Soulseek network login (other Soulseek users see this)
# SLSKD_UI_* = credentials for slskd's own web UI/API (unrelated to the Soulseek
#   network account above) — the setup wizard fills these in for you with the
#   same values you give it for SLSKD_NETWORK_*, so you don't need to set them
#   by hand unless you're skipping the wizard.
SLSKD_NETWORK_USERNAME=
SLSKD_NETWORK_PASSWORD=
SLSKD_UI_USERNAME=
SLSKD_UI_PASSWORD=
# Where slskd writes completed downloads, inside the /music volume postvinyl
# also mounts. Auto-filled by setup.sh from config/config.toml's
# [paths] download_dir (default "downloads"); kept in sync automatically if
# you change download_dir via the Config UI — see docs/deployment.md. Don't
# hand-edit unless you know what you're doing; get it wrong and every
# completed Soulseek transfer silently vanishes instead of reaching your library.
SLSKD_DOWNLOADS_DIR=

# --- postvinyl-proxy (HTTP-to-SOCKS5 proxy bridge) ---
# Only needed if ListenBrainz/Soulseek isn't reachable directly from your host.
# MUSICA_HTTP_PROXY is the on/off switch: leave it blank (the default) and
# postvinyl makes every outbound call — including MusicBrainz, which never
# needs a proxy — directly, no postvinyl-proxy container involved. Only set
# it to http://postvinyl-proxy:8080 if you've actually filled in the SOCKS5
# fields below; setting it while they're blank points postvinyl at a proxy
# with nowhere to go, and every outbound request fails with a 503.
MUSICA_HTTP_PROXY=
MUSICA_PROXY_USER=
MUSICA_PROXY_PASS=
MUSICA_PROXY_SOCKS_HOST=
MUSICA_PROXY_SOCKS_PORT=
NO_PROXY_LIST=localhost,127.0.0.1,navidrome-server,slskd,postvinyl
