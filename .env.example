# Post-Vinyl Docker stack. Copy to .env and fill in; never commit .env.
# Every value here can instead be written straight into the service's
# `environment:` in docker-compose.yml; keep secrets here rather than there.

# --- Folders ---
# Your music folder (must exist): Navidrome's library is its library/ subfolder,
# slskd downloads go under downloads/.
MUSIC_HOST_DIR=/path/to/host/music
# Where slskd saves finished downloads, inside /music (matches files.slskd_downloads_dir
# in post-vinyl.yaml; get it wrong and finished downloads are never picked up).
SLSKD_DOWNLOADS_DIR=/music/downloads/complete/soulseek
# Post-Vinyl's database folder on the host (default ./postvinyl_data).
PV_DATA_DIR=

# --- Post-Vinyl ---
# Encrypts stored per-user secrets (Navidrome passwords, ListenBrainz tokens).
# Generate with the command in the README. Back it up outside the database:
# losing it loses every stored secret. Rotation: new key first, comma-separated
# (new,old); drop the old one later.
PV_SECRET_KEY=
# The address people open the app at (scheme://host[:port]; used for the CSRF check).
PV_PUBLIC_ORIGIN=http://localhost:8092
# 1 serves the API docs at /docs; leave empty in production.
PV_DEV=

# --- slskd ---
# Any long random string; slskd and Post-Vinyl both read it.
SLSKD_API_KEY=
# Your Soulseek network login (others see the name; logging in the first time registers it).
SLSKD_NETWORK_USERNAME=
SLSKD_NETWORK_PASSWORD=
# slskd's own web UI login (unrelated to the Soulseek account).
SLSKD_UI_USERNAME=
SLSKD_UI_PASSWORD=

# --- Navidrome ---
# Optional: Navidrome's own ListenBrainz scrobbling.
LISTENBRAINZ_TOKEN=

# --- Optional HTTP-to-SOCKS5 proxy for Navidrome ---
# Leave MUSICA_HTTP_PROXY blank to connect directly. Set it to
# http://postvinyl-proxy:8080 only with the SOCKS5 fields filled in.
MUSICA_HTTP_PROXY=
MUSICA_PROXY_USER=
MUSICA_PROXY_PASS=
MUSICA_PROXY_SOCKS_HOST=
MUSICA_PROXY_SOCKS_PORT=
NO_PROXY_LIST=localhost,127.0.0.1,navidrome-server,slskd,postvinyl
